# Copy to .env and fill in per environment. See nuxt.config.ts for how each
# one is consumed.

# Base URL of the backend API (sales-system-api). The app appends /api/v1
# itself (see plugins/axios.ts) — don't include that suffix here.
API_URL=http://localhost:8080

# Sentry DSN for client-side error reporting (plugins/sentry.ts). Leave blank
# to disable Sentry entirely (the SDK no-ops on an empty dsn) — useful for
# local dev so you don't send local errors to the shared project.
SENTRY_DSN=

# Environment label attached to every Sentry event (e.g. development,
# staging, production). Defaults to "development" if unset.
APP_ENV=development

# Canonical site URL used by @nuxtjs/i18n for SEO tags (hreflang links,
# sitemap alternates). Only matters for production deploys.
NUXT_PUBLIC_SITE_URL=
